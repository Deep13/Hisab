<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
    controllerName="Hisab.Hisab.controller.TagadaSlip"
    xmlns:html="http://www.w3.org/1999/xhtml">
    <Page showNavButton="true" navButtonPress="onpressBack">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press="onpressBack"/>
                </contentLeft>
                <contentMiddle>
                    <Title text="Tagada Slip"/>
                </contentMiddle>
                <contentRight>
                    <Button text="Print Invoices" icon="sap-icon://document" press="onPrintInvoices" class="sapUiTinyMarginEnd"/>
                    <Button text="Download Excel" icon="sap-icon://excel-attachment" type="Emphasized" press="onDownloadExcel" class="sapUiTinyMarginEnd"/>
                    <Button text="Print" icon="sap-icon://print" type="Accept" press="onPrint"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <HBox class="sapUiSmallMargin" alignItems="End" wrapping="Wrap">
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Office" design="Bold"/>
                    <Select id="idOffice" selectedKey="Factory 01">
                        <core:Item key="Factory 01" text="Factory 01"/>
                        <core:Item key="Factory 02" text="Factory 02"/>
                        <core:Item key="Factory 03" text="Factory 03"/>
                        <core:Item key="Factory 04" text="Factory 04"/>
                    </Select>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Month" design="Bold"/>
                    <Select id="idMonth">
                        <core:Item key="01" text="January"/>
                        <core:Item key="02" text="February"/>
                        <core:Item key="03" text="March"/>
                        <core:Item key="04" text="April"/>
                        <core:Item key="05" text="May"/>
                        <core:Item key="06" text="June"/>
                        <core:Item key="07" text="July"/>
                        <core:Item key="08" text="August"/>
                        <core:Item key="09" text="September"/>
                        <core:Item key="10" text="October"/>
                        <core:Item key="11" text="November"/>
                        <core:Item key="12" text="December"/>
                    </Select>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Year" design="Bold"/>
                    <Select id="idYear">
                        <core:Item key="2023" text="2023"/>
                        <core:Item key="2024" text="2024"/>
                        <core:Item key="2025" text="2025"/>
                        <core:Item key="2026" text="2026"/>
                        <core:Item key="2027" text="2027"/>
                    </Select>
                </VBox>
                <VBox>
                    <Label text=" "/>
                    <Button text="Submit" type="Emphasized" icon="sap-icon://search" press="onLoadData"/>
                </VBox>
            </HBox>
            <Table id="idTable" sticky="ColumnHeaders" class="sapUiSizeCompact"
                items="{tagadaModel>/rows}">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Tagada Slip" id="idTableTitle"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="60px" hAlign="Center">
                        <Label text="SL"/>
                    </Column>
                    <Column>
                        <Label text="Party Name"/>
                    </Column>
                    <Column width="140px" hAlign="Right">
                        <Label text="Current"/>
                    </Column>
                    <Column width="140px" hAlign="Right">
                        <Label text="OD"/>
                    </Column>
                    <Column width="140px" hAlign="Right">
                        <Label text="Total"/>
                    </Column>
                    <Column width="60px" hAlign="Center">
                        <Label text=""/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{tagadaModel>sl}"/>
                            <Input value="{tagadaModel>partyName}" placeholder="Enter party name"
                                suggestionItems="{ClientModel>/Clients_results}"
                                showSuggestion="true">
                                <suggestionItems>
                                    <core:Item text="{ClientModel>client}"/>
                                </suggestionItems>
                            </Input>
                            <Text text="{tagadaModel>current}"/>
                            <Input value="{tagadaModel>od}" type="Number" liveChange="onOdChange" placeholder="0"/>
                            <Text text="{tagadaModel>total}" class="sapUiSmallMarginBegin"/>
                            <Button icon="sap-icon://delete" type="Transparent" press="onDeleteRow" tooltip="Delete row"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <OverflowToolbar>
                <Button icon="sap-icon://add" text="Add Row" press="onAddRow" type="Transparent"/>
                <ToolbarSpacer/>
                <Title level="H2" id="idGrandTotal" text="Grand Total: 0"/>
            </OverflowToolbar>
        </content>
    </Page>
</mvc:View>