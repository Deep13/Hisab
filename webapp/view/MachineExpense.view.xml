<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	controllerName="Hisab.Hisab.controller.MachineExpense"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Page class="sapUiSizeCompact" showNavButton="true" navButtonPress="onpressBack">
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://nav-back" press="onpressBack" />
				</contentLeft>
				<contentMiddle>
					<Title text="Expenses" />
				</contentMiddle>
				<contentRight>
					<Button icon="sap-icon://add" type="Emphasized" text="Add Machine"
						press="onAddMachine" />
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<IconTabBar id="idTabBar" expandable="false" stretchContentHeight="true"
				select="onTabSelect" class="sapUiResponsiveContentPadding">
				<items>
					<IconTabFilter text="Machines" key="machines" icon="sap-icon://machine">
						<VBox class="sapUiSmallMarginTop">
							<HBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginBottom">
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Search" design="Bold" />
									<SearchField id="idMachineSearch" width="14rem"
										placeholder="Machine or service name"
										liveChange="onMachineSearch" search="onMachineSearch" />
								</VBox>
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Office" design="Bold" />
									<ComboBox id="idMachineOffice" width="11rem"
										placeholder="All offices" items="{filters>/offices}"
										selectionChange="onMachineFilterChange"
										change="onMachineFilterChange">
										<items>
											<core:Item key="{filters>cc}" text="{filters>cc}" />
										</items>
									</ComboBox>
								</VBox>
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Machine Type" design="Bold" />
									<ComboBox id="idMachineType" width="11rem" placeholder="All types"
										items="{filters>/types}"
										selectionChange="onMachineFilterChange"
										change="onMachineFilterChange">
										<items>
											<core:Item key="{filters>type}" text="{filters>type}" />
										</items>
									</ComboBox>
								</VBox>
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Spend" design="Bold" />
									<Select id="idSpendFilter" width="11rem"
										change="onMachineFilterChange">
										<core:Item key="all" text="Any amount" />
										<core:Item key="none" text="No expenses yet" />
										<core:Item key="some" text="Has expenses" />
									</Select>
								</VBox>
								<Button icon="sap-icon://sort" text="Sort" press="onSortMachines"
									class="sapUiSmallMarginEnd" />
								<Button icon="sap-icon://clear-filter" text="Clear"
									press="onClearMachineFilters" />
							</HBox>

							<Table id="idMachineTable" sticky="ColumnHeaders" growing="true"
								growingThreshold="25" growingScrollToLoad="true"
								items="{machines>/results}"
								noDataText="No machines yet. Use 'Add Machine' to create one.">
								<headerToolbar>
									<OverflowToolbar>
										<Title id="idMachineCount" text="Machines" level="H2" />
										<ToolbarSpacer />
										<ObjectStatus id="idMachineTotal" state="Information"
											icon="sap-icon://money-bills" />
									</OverflowToolbar>
								</headerToolbar>
								<columns>
									<Column>
										<Label text="Machine" design="Bold" />
									</Column>
									<Column>
										<Label text="Office" design="Bold" />
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true">
										<Label text="Type" design="Bold" />
									</Column>
									<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"
										width="7rem">
										<Label text="Entries" design="Bold" />
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" width="9rem">
										<Label text="Last Expense" design="Bold" />
									</Column>
									<Column hAlign="End" width="9rem">
										<Label text="Total Spend" design="Bold" />
									</Column>
								</columns>
								<items>
									<ColumnListItem type="Navigation" press="onMachinePress">
										<cells>
											<ObjectIdentifier title="{machines>machineName}" />
											<Text text="{machines>cc}" />
											<Text text="{machines>type}" />
											<Text text="{machines>expenseCount}" />
											<Text
												text="{ path: 'machines>lastServicedOn', formatter: '.formatter.displayDate' }" />
											<ObjectNumber
												number="{ path: 'machines>totalAmount', formatter: '.formatter.amount' }"
												unit="INR"
												state="{ path: 'machines>totalAmount', formatter: '.formatter.amountState' }" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</IconTabFilter>

					<IconTabFilter text="Report" key="report" icon="sap-icon://bar-chart">
						<VBox class="sapUiSmallMarginTop">
							<HBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginBottom">
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Date Range" design="Bold" required="true" />
									<DateRangeSelection id="idReportRange" width="17rem"
										displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd"
										change="onReportRangeChange" />
								</VBox>
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Office" design="Bold" />
									<ComboBox id="idReportOffice" width="11rem"
										placeholder="All offices" items="{filters>/offices}">
										<items>
											<core:Item key="{filters>cc}" text="{filters>cc}" />
										</items>
									</ComboBox>
								</VBox>
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Machine Type" design="Bold" />
									<ComboBox id="idReportType" width="11rem" placeholder="All types"
										items="{filters>/types}">
										<items>
											<core:Item key="{filters>type}" text="{filters>type}" />
										</items>
									</ComboBox>
								</VBox>
								<Button text="Show Report" type="Emphasized" icon="sap-icon://refresh"
									press="onRunReport" class="sapUiSmallMarginEnd" />
								<Button text="Last 12 Months" press="onReportLastYear"
									class="sapUiTinyMarginEnd" />
								<Button text="All Time" press="onReportAllTime" />
							</HBox>

							<HBox wrap="Wrap" class="sapUiSmallMarginBottom">
								<GenericTile class="sapUiTinyMarginEnd tileLayout" header="Total Spend"
									subheader="Selected range">
									<TileContent>
										<NumericContent id="idKpiTotal" value="0" truncateValueTo="12"
											valueColor="Critical" icon="sap-icon://money-bills" />
									</TileContent>
								</GenericTile>
								<GenericTile class="sapUiTinyMarginEnd tileLayout" header="Machines"
									subheader="With expenses">
									<TileContent>
										<NumericContent id="idKpiMachines" value="0" truncateValueTo="8"
											valueColor="Good" icon="sap-icon://machine" />
									</TileContent>
								</GenericTile>
								<GenericTile class="sapUiTinyMarginEnd tileLayout" header="Entries"
									subheader="Expense records">
									<TileContent>
										<NumericContent id="idKpiEntries" value="0" truncateValueTo="8"
											valueColor="Neutral" icon="sap-icon://list" />
									</TileContent>
								</GenericTile>
							</HBox>

							<Panel headerText="Expense by Machine" class="sapUiSmallMarginBottom">
								<content>
									<core:HTML id="idChartHtml"
										content="&lt;div id=&quot;machineExpenseChartDiv&quot; style=&quot;width:100%;min-height:360px&quot;&gt;&lt;/div&gt;" />
								</content>
							</Panel>

							<Table id="idReportTable" items="{report>/results}" growing="true"
								growingThreshold="25" noDataText="Pick a date range and press 'Show Report'.">
								<headerToolbar>
									<OverflowToolbar>
										<Title id="idReportTitle" text="Breakdown" level="H2" />
									</OverflowToolbar>
								</headerToolbar>
								<columns>
									<Column>
										<Label text="Machine" design="Bold" />
									</Column>
									<Column>
										<Label text="Office" design="Bold" />
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true">
										<Label text="Type" design="Bold" />
									</Column>
									<Column hAlign="End" width="7rem">
										<Label text="Entries" design="Bold" />
									</Column>
									<Column hAlign="End" width="9rem">
										<Label text="Total" design="Bold" />
									</Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<ObjectIdentifier title="{report>machineName}" />
											<Text text="{report>cc}" />
											<Text text="{report>type}" />
											<Text text="{report>expenseCount}" />
											<ObjectNumber
												number="{ path: 'report>totalAmount', formatter: '.formatter.amount' }"
												unit="INR" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</IconTabFilter>

					<IconTabFilter text="Electricity" key="electricity" icon="sap-icon://energy-saving-lightbulb">
						<VBox class="sapUiSmallMarginTop">
							<Table id="idMeterTable" inset="false" fixedLayout="false"
								items="{elecModel>/meters}"
								noDataText="No meters yet. Use 'Add Meter' to record a connection.">
								<headerToolbar>
									<OverflowToolbar>
										<Title text="Meters" />
										<ToolbarSpacer />
										<Button text="Add Meter" icon="sap-icon://add" type="Transparent"
											press="onAddMeter" />
									</OverflowToolbar>
								</headerToolbar>
								<columns>
									<Column width="12rem"><Label text="Nickname" /></Column>
									<Column><Label text="Consumer Name" /></Column>
									<Column width="10rem"><Label text="Customer ID" /></Column>
									<Column width="10rem"><Label text="Meter Number" /></Column>
									<Column width="9rem"><Label text="Location" /></Column>
									<Column width="7rem" hAlign="End"><Label text="Bills" /></Column>
									<Column width="10rem" hAlign="End"><Label text="Billed Total" /></Column>
									<Column width="7rem" hAlign="Center"><Label text="" /></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{elecModel>nickname}" />
											<Text text="{elecModel>consumer_name}" />
											<Text text="{elecModel>customer_id}" />
											<Text text="{elecModel>meter_number}" />
											<Text text="{elecModel>cc}" />
											<Text text="{elecModel>billCount}" />
											<Text text="{elecModel>totalAmount}" />
											<HBox justifyContent="Center">
												<Button icon="sap-icon://edit" type="Transparent" tooltip="Edit meter"
													press="onEditMeter" />
												<Button icon="sap-icon://delete" type="Transparent" tooltip="Delete meter"
													press="onDeleteMeter" />
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>

							<HBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Month" design="Bold" />
									<Select id="idBillMonth" change="onBillFilterChange">
										<core:Item key="1" text="January" />
										<core:Item key="2" text="February" />
										<core:Item key="3" text="March" />
										<core:Item key="4" text="April" />
										<core:Item key="5" text="May" />
										<core:Item key="6" text="June" />
										<core:Item key="7" text="July" />
										<core:Item key="8" text="August" />
										<core:Item key="9" text="September" />
										<core:Item key="10" text="October" />
										<core:Item key="11" text="November" />
										<core:Item key="12" text="December" />
									</Select>
								</VBox>
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Year" design="Bold" />
									<Select id="idBillYear" change="onBillFilterChange">
										<core:Item key="2024" text="2024" />
										<core:Item key="2025" text="2025" />
										<core:Item key="2026" text="2026" />
										<core:Item key="2027" text="2027" />
										<core:Item key="2028" text="2028" />
									</Select>
								</VBox>
								<VBox>
									<Label text=" " />
									<ObjectStatus title="Month Total" text="{elecModel>/billTotalText}" state="Information" />
								</VBox>
							</HBox>

							<Table id="idBillTable" inset="false" fixedLayout="false"
								items="{ path: 'elecModel>/bills', sorter: { path: 'cc', group: true } }"
								noDataText="No electricity bills recorded for this month.">
								<headerToolbar>
									<OverflowToolbar>
										<Title text="Monthly Bills" />
										<ToolbarSpacer />
										<Button text="Print" icon="sap-icon://print" type="Transparent"
											press="onPrintBills" />
										<Button text="Add Bill" icon="sap-icon://add" type="Transparent"
											press="onAddBill" />
									</OverflowToolbar>
								</headerToolbar>
								<columns>
									<Column width="12rem"><Label text="Nickname" /></Column>
									<Column><Label text="Consumer Name" /></Column>
									<Column width="12rem"><Label text="Customer ID" /></Column>
									<Column width="12rem"><Label text="Meter Number" /></Column>
									<Column width="10rem" hAlign="End"><Label text="Amount" /></Column>
									<Column width="7rem" hAlign="Center"><Label text="" /></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{elecModel>nickname}" />
											<Text text="{elecModel>consumer_name}" />
											<Text text="{elecModel>customer_id}" />
											<Text text="{elecModel>meter_number}" />
											<Text text="{elecModel>amount}" />
											<HBox justifyContent="Center">
												<Button icon="sap-icon://edit" type="Transparent" tooltip="Edit bill"
													press="onEditBill" />
												<Button icon="sap-icon://delete" type="Transparent" tooltip="Delete bill"
													press="onDeleteBill" />
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
	</Page>
</mvc:View>
