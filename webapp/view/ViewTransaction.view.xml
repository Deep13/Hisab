<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	controllerName="Hisab.Hisab.controller.ViewTransaction"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Page class="sapUiSizeCompact" showNavButton="true" navButtonPress="onpressBack">
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://nav-back" press="onpressBack" />
				</contentLeft>
				<contentMiddle>
					<Title text="R&amp;D Enterprise"></Title>
				</contentMiddle>
			</Bar>
		</customHeader>
		<content>
			<HBox class="sapUiSmallMargin">
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Select Office" design="Bold" />
					<ComboBox id="idOffice" change="onChangeSelection" selectedKey="All">
						<core:Item key="Factory 01" text="Factory 01" />
						<core:Item key="Factory 02" text="Factory 02" />
						<core:Item key="Factory 03" text="Factory 03" />
						<core:Item key="Factory 04" text="Factory 04" />
					</ComboBox>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Operation" design="Bold" />
					<ComboBox id="idOperation" change="onChangeSelectionOp" selectedKey="All">
						<core:Item key="Shaving" text="Shaving" />
						<core:Item key="Buffing" text="Buffing" />
						<core:Item key="Softening" text="Softening" />
						<core:Item key="Milling" text="Milling" />
						<core:Item key="Tangan" text="Tangan" />
						<core:Item key="Thokai" text="Thokai" />
					</ComboBox>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Client" design="Bold" />
					<ComboBox items="{ClientModel>/Clients_results}"
						change="onChangeSelectionClient">
						<items>
							<core:Item key="{ClientModel>client}" text="{ClientModel>client}" />
						</items>
					</ComboBox>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Labour" design="Bold" />
					<ComboBox items="{ComboModel>/Labour_results}" change="onChangeSelectionLabour">
						<items>
							<core:Item key="{ComboModel>Labor}" text="{ComboModel>Labor}" />
						</items>
					</ComboBox>
				</VBox>
			</HBox>
			<Table id="idTable" headerText="Client Transactions" sticky="ColumnHeaders"
				growing="true" growingThreshold="20" class="sapUiSizeCompact"
				items="{detailsModel>/results}">
				<columns>
					<Column hAlign="Left">
						<Label text="Date" />
					</Column>
					<Column hAlign="Left">
						<Label text="Office" />
					</Column>
					<Column hAlign="Left">
						<Label text="Client" />
					</Column>
					<Column hAlign="Left">
						<Label text="Labour" />
					</Column>
					<Column hAlign="Left">
						<Label text="Operation" />
					</Column>
					<Column hAlign="Left" width="7rem">
						<Label text="Quantity/Hours" />
					</Column>
					<Column hAlign="Left" width="5rem">
						<Label text="Rate" />
					</Column>
					<Column hAlign="Left" width="5rem">
						<Label text="Amount" />
					</Column>
					<Column />
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<VBox>
								<DatePicker displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy"
									value="{detailsModel>date}"
									visible="{= ${detailsModel>Edit} ? true : false }" />
								<Text text="{detailsModel>date}"
									visible="{= ${detailsModel>Edit} ? false : true }" />
							</VBox>
							<VBox>
								<Text text="{detailsModel>cc}"
									visible="{= ${detailsModel>Edit} ? false : true }" />
								<ComboBox selectedKey="{detailsModel>cc}"
									visible="{= ${detailsModel>Edit} ? true : false }">
									<core:Item key="Factory 01" text="Factory 01" />
									<core:Item key="Factory 02" text="Factory 02" />
									<core:Item key="Factory 03" text="Factory 03" />
									<core:Item key="Factory 04" text="Factory 04" />
								</ComboBox>
							</VBox>
							<VBox>
								<Text text="{detailsModel>client}"
									visible="{= ${detailsModel>Edit} ? false : true }" />
								<ComboBox selectedKey="{detailsModel>client}"
									items="{ClientModel>/Clients_results}"
									visible="{= ${detailsModel>Edit} ? true : false }">
									<items>
										<core:Item key="{ClientModel>client}"
											text="{ClientModel>client}" />
									</items>
								</ComboBox>
							</VBox>
							<VBox>
								<Text text="{detailsModel>labour}"
									visible="{= ${detailsModel>Edit} ? false : true }" />
								<ComboBox selectedKey="{detailsModel>labour}"
									items="{ComboModel>/Labour_results}"
									visible="{= ${detailsModel>Edit} ? true : false }">
									<items>
										<core:Item key="{ComboModel>Labor}"
											text="{ComboModel>Labor}" />
									</items>
								</ComboBox>
							</VBox>
							<VBox>
								<Text text="{detailsModel>machineType}"
									visible="{= ${detailsModel>Edit} ? false : true }" />
								<ComboBox selectedKey="{detailsModel>machineType}"
									visible="{= ${detailsModel>Edit} ? true : false }">
									<core:Item key="Shaving" text="Shaving" />
									<core:Item key="Buffing" text="Buffing" />
									<core:Item key="Softening" text="Softening" />
									<core:Item key="Milling" text="Milling" />
									<core:Item key="Tangan" text="Tangan" />
									<core:Item key="Thokai" text="Thokai" />
								</ComboBox>
							</VBox>
							<VBox>
								<Input value="{detailsModel>quantity}"
									visible="{= ${detailsModel>Edit} ? true : false }"
									liveChange="onQuantityChange" />
								<Text text="{detailsModel>quantity}"
									visible="{= ${detailsModel>Edit} ? false : true }" />
							</VBox>
							<VBox>
								<Input value="{detailsModel>rate}"
									visible="{= ${detailsModel>Edit} ? true : false }"
									liveChange="onRateChange" />
								<Text text="{detailsModel>rate}"
									visible="{= ${detailsModel>Edit} ? false : true }" />
							</VBox>
							<Text text="{detailsModel>total}" />
							<HBox>
								<Button text="Edit" press="onEdit"
									visible="{= ${detailsModel>Edit} ? false : true }" />
								<Button class="sapUiTinyMarginEnd" text="Save" press="onSave"
									visible="{= ${detailsModel>Edit} ? true : false }" />
								<Button text="Cancel" press="onCancel"
									visible="{= ${detailsModel>Edit} ? true : false }" />
							</HBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>