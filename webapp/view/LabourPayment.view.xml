<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	controllerName="Hisab.Hisab.controller.LabourPayment"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Page title="Generate Labour Receipt" showNavButton="true" navButtonPress="onpressBack"
		titleAlignment="Center">
		<content>
			<HBox class="sapUiSmallMargin">
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Select Office" design="Bold" required="true" />
					<ComboBox id="idOffice" selectionChange="onChangeSelection" selectedKey="All">
						<core:Item key="All" text="All" />
						<core:Item key="Factory 01" text="Factory 01" />
						<core:Item key="Factory 02" text="Factory 02" />
						<core:Item key="Factory 03" text="Factory 03" />
						<core:Item key="Factory 04" text="Factory 04" />
					</ComboBox>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Select Labour" design="Bold" required="true" />
					<ComboBox id="idClient" items="{ComboModel>/Clients_results}">
						<items>
							<core:Item key="{ComboModel>Labor}" text="{ComboModel>Labor}" />
						</items>
					</ComboBox>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Start Date" design="Bold" required="true" />
					<DatePicker id="datePicker" displayFormat="dd-MM-yyyy" valueFormat="YYYY-MM-dd"
						value="{/Date}" />
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="End Date" design="Bold" required="true" />
					<DatePicker id="datePicker2" displayFormat="dd-MM-yyyy" valueFormat="YYYY-MM-dd"
						value="{/Date}" />
				</VBox>
				<VBox>
					<Label />
					<Button text="Get Transactions" press="onGetTransaction" />
				</VBox>
			</HBox>
			<VBox id="idClientTx" visible="false">
				<VBox class="sapUiMediumMarginEnd">
					<!--Table
					to get User Inputs-->
					<Table id="idTable" headerText="Client Transactions" sticky="ColumnHeaders"
						growing="true" growingThreshold="20" class="sapUiSizeCompact"
						items="{detailsModel>/results}">
						<columns>
							<Column hAlign="Left">
								<Label text="Date" />
							</Column>
							<Column hAlign="Left">
								<Label text="Office" />
							</Column>
							<Column hAlign="Left">
								<Label text="Client" />
							</Column>
							<Column hAlign="Left">
								<Label text="Operation" />
							</Column>
							<Column hAlign="Left">
								<Label text="Quantity/Hours" />
							</Column>
							<Column hAlign="Left">
								<Label text="Rate" />
							</Column>
							<Column hAlign="Left">
								<Label text="Amount" />
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<cells>
									<Text text="{detailsModel>date}" />
									<Text text="{detailsModel>cc}" />
									<Text text="{detailsModel>client}" />
									<Text text="{detailsModel>machineType}" />
									<Text text="{detailsModel>quantity}" />
									<Text text="{detailsModel>rate}" />
									<Text text="{detailsModel>total}" />
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</VBox>
			</VBox>
		</content>
		<!--Footer
		to perform Operation : Save and Reset-->
		<footer>
			<OverflowToolbar id="otbFooterCPOverview">
				<ToolbarSpacer />
				<VBox class="sapUiMediumMargin">
					<Title level="H1" id="idTotal" />
					<Title level="H1" id="idPay" />
				</VBox>
				<!-- <Button type="Reject" text="{i18n>Reset}" press="onResetTransaction"/>
				<Button type="Accept" text="{i18n>GenerateInvoice}" press="onGenerateInvoice">
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
				</Button> -->
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>