<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	controllerName="Hisab.Hisab.controller.Khazana"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Page class="sapUiSizeCompact" showNavButton="true" navButtonPress="onpressBack">
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://nav-back" press="onpressBack" />
				</contentLeft>
				<contentMiddle>
					<Title text="R&amp;D Enterprise"></Title>
				</contentMiddle>
			</Bar>
		</customHeader>
		<content>
			<HBox class="sapUiSmallMargin">
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Select Office" design="Bold" />
					<ComboBox id="idOffice" change="onChangeSelection" selectedKey="All">
						<core:Item key="Factory 01" text="Factory 01" />
						<core:Item key="Factory 02" text="Factory 02" />
						<core:Item key="Factory 03" text="Factory 03" />
						<core:Item key="Factory 04" text="Factory 04" />
					</ComboBox>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Start Date" design="Bold" required="true" />
					<DatePicker id="datePicker" displayFormat="dd-MM-yyyy" valueFormat="YYYY-MM-dd" />
				</VBox>
				<VBox>
					<Label />
					<Button text="Get Transactions" press="onGetTransaction" />
				</VBox>
			</HBox>
			<Table id="idTable" headerText="Khazana" sticky="ColumnHeaders" growing="true"
				growingThreshold="20" class="sapUiSizeCompact" items="{detailsModel>/results}">
				<columns>
					<Column hAlign="Left">
						<Label text="Client" />
					</Column>
					<Column hAlign="Left">
						<Label text="Office" />
					</Column>
					<Column hAlign="Left">
						<Label text="OD" />
					</Column>
					<Column hAlign="Left">
						<Label text="Payment" />
					</Column>
					<Column hAlign="Left">
						<Label text="Current" />
					</Column>
					<Column hAlign="Left">
						<Label text="Total" />
					</Column>
					<Column />
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{detailsModel>client}" />
							<Text text="{detailsModel>cc}" />
							<Text text="{detailsModel>overdue}" />
							<Text text="{detailsModel>payment}" />
							<Text text="{detailsModel>current}" />
							<Text
								text="{parts: [{path: 'detailsModel>current'}, {path: 'detailsModel>overdue'},{path: 'detailsModel>payment'}],formatter: '.getTotal' }" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>