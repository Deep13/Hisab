<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
	controllerName="Hisab.Hisab.controller.DailyKhata"
	xmlns:html="http://www.w3.org/1999/xhtml">
	<Page showNavButton="true" navButtonPress="onpressBack">
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://nav-back" press="onpressBack"/>
				</contentLeft>
				<contentMiddle>
					<Title text="Daily Khata"/>
				</contentMiddle>
				<contentRight>
					<Button text="Opening Balances" icon="sap-icon://initiative" press="onOpeningBalances"
						class="sapUiTinyMarginEnd"/>
					<Button text="Print" icon="sap-icon://print" type="Accept" press="onPrintDay"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<MessageStrip id="idNoOpeningStrip" visible="false"
				text="No opening cash balance has been set yet, so the carried-forward figure counts every machine expense ever recorded and will look wrong. Open Opening Balances and set the day you are starting from."
				type="Warning" showIcon="true" class="sapUiSmallMargin"/>

			<HBox class="sapUiSmallMargin" alignItems="End" wrapping="Wrap">
				<VBox class="sapUiSmallMarginEnd">
					<Label text="Date" design="Bold"/>
					<DatePicker id="idKhataDate" displayFormat="dd-MM-yyyy" valueFormat="yyyy-MM-dd"
						change="onDateChange"/>
				</VBox>
				<VBox class="sapUiSmallMarginEnd">
					<Label text=" "/>
					<Button text="Previous Day" icon="sap-icon://navigation-left-arrow" press="onPreviousDay"/>
				</VBox>
				<VBox>
					<Label text=" "/>
					<Button text="Next Day" icon="sap-icon://navigation-right-arrow" press="onNextDay"/>
				</VBox>
			</HBox>

			<HBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd" wrapping="Wrap">
				<ObjectStatus title="Carried Forward" text="{khataModel>/carriedText}"
					class="sapUiMediumMarginEnd"/>
				<ObjectStatus title="Total Credit" text="{khataModel>/totalCreditText}" state="Success"
					class="sapUiMediumMarginEnd"/>
				<ObjectStatus title="Total Debit" text="{khataModel>/totalDebitText}" state="Error"
					class="sapUiMediumMarginEnd"/>
				<ObjectStatus title="Closing Balance" text="{khataModel>/closingText}"
					state="{khataModel>/closingState}"/>
			</HBox>

			<Table id="idCreditTable" class="sapUiSmallMargin sapUiSizeCompact" inset="false"
				fixedLayout="false" items="{khataModel>/credits}">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="Credit  (money in)"/>
						<ToolbarSpacer/>
						<Button text="Add Credit" icon="sap-icon://add" type="Transparent" press="onAddCredit"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column width="12rem"><Label text="Against"/></Column>
					<Column><Label text="Client / Details"/></Column>
					<Column width="10rem" hAlign="End"><Label text="Amount"/></Column>
					<Column width="6rem" hAlign="Center"><Label text=""/></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{khataModel>categoryLabel}"/>
							<Text text="{khataModel>details}"/>
							<Text text="{khataModel>amount}"/>
							<HBox justifyContent="Center">
								<Button icon="sap-icon://edit" type="Transparent" tooltip="Edit" press="onEditEntry"/>
								<Button icon="sap-icon://delete" type="Transparent" tooltip="Delete" press="onDeleteEntry"/>
							</HBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>

			<Table id="idDebitTable" class="sapUiSmallMargin sapUiSizeCompact" inset="false"
				fixedLayout="false" items="{khataModel>/debits}">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="Debit  (money out)"/>
						<ToolbarSpacer/>
						<Button text="Add Debit" icon="sap-icon://add" type="Transparent" press="onAddDebit"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column width="12rem"><Label text="Against"/></Column>
					<Column><Label text="Details"/></Column>
					<Column width="10rem" hAlign="End"><Label text="Amount"/></Column>
					<Column width="6rem" hAlign="Center"><Label text=""/></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{khataModel>categoryLabel}"/>
							<Text text="{khataModel>details}"/>
							<Text text="{khataModel>amount}"/>
							<HBox justifyContent="Center">
								<Button icon="sap-icon://edit" type="Transparent" tooltip="Edit" press="onEditEntry"/>
								<Button icon="sap-icon://delete" type="Transparent" tooltip="Delete" press="onDeleteEntry"/>
							</HBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>
