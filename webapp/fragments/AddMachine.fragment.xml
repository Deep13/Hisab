<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout.form">
	<Dialog id="idAddMachineDialog" title="Add Machine" class="sapUiSizeCompact"
		contentWidth="26rem">
		<content>
			<l:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanS="12"
				labelSpanM="4" columnsM="1" class="sapUiNoContentPadding">
				<l:content>
					<Label text="Office" required="true" />
					<ComboBox id="idNewMachineOffice" width="100%" placeholder="Select office"
						items="{filters>/offices}">
						<items>
							<core:Item key="{filters>cc}" text="{filters>cc}" />
						</items>
					</ComboBox>

					<Label text="Machine Name" required="true" />
					<Input id="idNewMachineName" width="100%" maxLength="30"
						placeholder="e.g. Shaving 5" />

					<Label text="Machine Type" required="true" />
					<ComboBox id="idNewMachineType" width="100%" placeholder="Select type"
						items="{filters>/allTypes}">
						<items>
							<core:Item key="{filters>type}" text="{filters>type}" />
						</items>
					</ComboBox>
				</l:content>
			</l:SimpleForm>
		</content>
		<beginButton>
			<Button text="Create" type="Emphasized" press="onSaveMachine" />
		</beginButton>
		<endButton>
			<Button text="Cancel" press="onCancelMachine" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
