{
  "_version": "1.12.0",
  "sap.app": {
    "id": "Hisab.Hisab",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "ui5template.basicSAPUI5ApplicationProject",
      "version": "1.40.12"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": {
      "viewName": "Hisab.Hisab.view.Main",
      "type": "XML",
      "async": true,
      "id": "Main"
    },
    "dependencies": {
      "minUI5Version": "1.65.6",
      "libs": {
        "sap.ui.layout": {},
        "sap.ui.core": {},
        "sap.m": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "Hisab.Hisab.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "Hisab.Hisab.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "Main",
          "pattern": "Main",
          "target": "Main"
        },
        {
          "name": "TransactionShaving",
          "pattern": "TransactionShaving",
          "target": "TransactionShaving"
        },
        {
          "name": "TransactionBuffing",
          "pattern": "TransactionBuffing",
          "target": "TransactionBuffing"
        },
        {
          "name": "TransactionMilling",
          "pattern": "TransactionMilling",
          "target": "TransactionMilling"
        },
        {
          "name": "TransactionSoftening",
          "pattern": "TransactionSoftening",
          "target": "TransactionSoftening"
        },
        {
          "name": "TransactionTangan",
          "pattern": "TransactionTangan",
          "target": "TransactionTangan"
        },
        {
          "name": "TransactionThokai",
          "pattern": "TransactionThokai",
          "target": "TransactionThokai"
        },
        {
          "name": "LabourPayment",
          "pattern": "LabourPayment",
          "target": "LabourPayment"
        },
        {
          "name": "ClientPayment",
          "pattern": "ClientPayment",
          "target": "ClientPayment"
        },
        {
          "name": "ViewTransaction",
          "pattern": "ViewTransaction",
          "target": "ViewTransaction"
        },
        {
          "name": "Routine",
          "pattern": "Routine",
          "target": "Routine"
        },
        {
          "name": "MachineExpense",
          "pattern": "MachineExpense",
          "target": "MachineExpense"
        },
        {
          "name": "MachineExpenseDetail",
          "pattern": "MachineExpense/{machineDetail}",
          "target": "MachineExpenseDetail"
        },
        {
          "name": "Invoice",
          "pattern": "Invoice/{clientData}",
          "target": "Invoice"
        },
        {
          "name": "MasterClient",
          "pattern": "MasterClient",
          "target": "MasterClient"
        },
        {
          "name": "Analytics",
          "pattern": "Analytics",
          "target": "Analytics"
        },
        {
          "name": "Khazana",
          "pattern": "Khazana",
          "target": "Khazana"
        },
        {
          "name": "TagadaSlip",
          "pattern": "TagadaSlip",
          "target": "TagadaSlip"
        },
        {
          "name": "ProfitLoss",
          "pattern": "ProfitLoss",
          "target": "ProfitLoss"
        },
        {
          "name": "RateSettings",
          "pattern": "RateSettings",
          "target": "RateSettings"
        },
        {
          "name": "Notice",
          "pattern": "Notice",
          "target": "Notice"
        }
      ],
      "targets": {
        "Main": {
          "viewType": "XML",
          "transition": "slide",
          "viewName": "Main"
        },
        "MachineExpense": {
          "viewType": "XML",
          "transition": "slide",
          "viewName": "MachineExpense"
        },
        "MachineExpenseDetail": {
          "viewType": "XML",
          "transition": "slide",
          "viewName": "MachineExpenseDetail"
        },
        "Routine": {
          "viewType": "XML",
          "transition": "slide",
          "viewName": "Routine"
        },
        "TransactionShaving": {
          "viewType": "XML",
          "transition": "slide",
          "viewName": "TransactionShaving"
        },
        "TransactionBuffing": {
          "viewType": "XML",
          "viewName": "TransactionBuffing"
        },
        "TransactionMilling": {
          "viewType": "XML",
          "viewName": "TransactionMilling"
        },
        "TransactionSoftening": {
          "viewType": "XML",
          "viewName": "TransactionSoftening"
        },
        "TransactionTangan": {
          "viewType": "XML",
          "viewName": "TransactionTangan"
        },
        "TransactionThokai": {
          "viewType": "XML",
          "viewName": "TransactionThokai"
        },
        "LabourPayment": {
          "viewType": "XML",
          "viewName": "LabourPayment"
        },
        "ClientPayment": {
          "viewType": "XML",
          "viewName": "ClientPayment"
        },
        "ViewTransaction": {
          "viewType": "XML",
          "viewName": "ViewTransaction"
        },
        "Invoice": {
          "viewType": "XML",
          "viewName": "Invoice"
        },
        "MasterClient": {
          "viewType": "XML",
          "viewName": "MasterClient"
        },
        "Analytics": {
          "viewType": "XML",
          "viewName": "Analytics"
        },
        "Khazana": {
          "viewType": "XML",
          "viewName": "Khazana"
        },
        "TagadaSlip": {
          "viewType": "XML",
          "viewName": "TagadaSlip"
        },
        "ProfitLoss": {
          "viewType": "XML",
          "viewName": "ProfitLoss"
        },
        "RateSettings": {
          "viewType": "XML",
          "viewName": "RateSettings"
        },
        "Notice": {
          "viewType": "XML",
          "transition": "slide",
          "viewName": "Notice"
        }
      }
    }
  }
}
